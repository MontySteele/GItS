{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teyvat-spire.invalid/telemetry/run-v1.json",
  "title": "Teyvat Spire run record, schema v1",
  "description": "One finished, non-abandoned run, trimmed from the game's SerializableRun by the mod. Game ids and numbers only: no Steam id, no net id, no names, no free text. The Worker rejects any field not listed here, at every level.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_uuid", "install_id", "mod_version", "variant",
    "build_id", "character", "ascension", "game_mode", "coop", "partners",
    "victory", "floor_reached", "act_reached", "acts",
    "killed_by_encounter", "killed_by_event", "run_time_s",
    "deck", "relics", "floors", "ancients"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_uuid": { "$ref": "#/$defs/uuid4", "description": "Random per run, made by the mod; the idempotency key." },
    "install_id": { "$ref": "#/$defs/uuid4", "description": "Random per install, made and stored by the mod. Never derived from Steam." },
    "mod_version": { "$ref": "#/$defs/version" },
    "variant": { "enum": ["beta", "public"] },
    "build_id": { "$ref": "#/$defs/version", "description": "The game's build id, e.g. v0.111.0." },
    "character": { "$ref": "#/$defs/id" },
    "ascension": { "type": "integer", "minimum": 0, "maximum": 20 },
    "game_mode": { "type": "string", "pattern": "^[a-z_]{1,24}$" },
    "coop": { "type": "boolean" },
    "partners": {
      "description": "Character ids of the other players in a co-op run; empty when solo.",
      "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/id" }
    },
    "victory": { "type": "boolean" },
    "floor_reached": { "type": "integer", "minimum": 0, "maximum": 120 },
    "act_reached": { "type": "integer", "minimum": 0, "maximum": 9 },
    "acts": { "type": "array", "maxItems": 9, "items": { "$ref": "#/$defs/id" } },
    "killed_by_encounter": { "$ref": "#/$defs/idOrNull" },
    "killed_by_event": { "$ref": "#/$defs/idOrNull" },
    "run_time_s": { "type": "integer", "minimum": 0, "maximum": 10000000 },
    "deck": {
      "type": "array", "maxItems": 300,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "upgrades"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "upgrades": { "type": "integer", "minimum": 0, "maximum": 99 }
        }
      }
    },
    "relics": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/id" } },
    "floors": {
      "description": "One entry per map point, in order, for the local player only.",
      "type": "array", "maxItems": 120,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["floor", "act", "type", "room", "hp", "max_hp", "damage_taken"],
        "properties": {
          "floor": { "type": "integer", "minimum": 1, "maximum": 120 },
          "act": { "type": "integer", "minimum": 1, "maximum": 9 },
          "type": { "type": "string", "pattern": "^[a-z_]{1,24}$", "description": "map_point_type: monster, elite, boss, unknown, shop, rest_site, treasure, ancient." },
          "room": { "$ref": "#/$defs/idOrNull", "description": "The last room's model id (encounter or event), if any." },
          "hp": { "$ref": "#/$defs/hp" },
          "max_hp": { "$ref": "#/$defs/hp" },
          "damage_taken": { "$ref": "#/$defs/hp" },
          "card_choice": {
            "description": "Present when the floor offered cards. picked empty = skipped.",
            "type": "object", "additionalProperties": false,
            "required": ["offered", "picked"],
            "properties": {
              "offered": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/id" } },
              "picked": { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/id" } }
            }
          }
        }
      }
    },
    "ancients": {
      "type": "array", "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["floor", "offered", "picked"],
        "properties": {
          "floor": { "type": "integer", "minimum": 1, "maximum": 120 },
          "offered": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/id" } },
          "picked": { "$ref": "#/$defs/idOrNull" }
        }
      }
    }
  },
  "$defs": {
    "uuid4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "version": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[0-9A-Za-z._+-]+$" },
    "id": {
      "description": "A game or mod model id such as CARD.KLEEMOD-PROTO_FS_CRASHING_WAVES. No spaces, so no free text fits.",
      "type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9_.:+-]+$"
    },
    "idOrNull": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "hp": { "type": "integer", "minimum": 0, "maximum": 100000 }
  }
}
