<Project Sdk="Microsoft.NET.Sdk">

  <!-- Track M spine probe. THROWAWAY: this is not part of the shipped mod, is
       not referenced by klee-mod, and its output is deleted by
       cleanup_probe.ps1. It exists to answer one question in-game (M-Q3) and
       then go away. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>spineprobe</AssemblyName>
    <RootNamespace>SpineProbe</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <!-- Machine-local paths come from the mod's own local.props (gitignored),
       so this file hardcodes no Steam path (spec section 0.3). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\klee-mod\local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\klee-mod\local.props')" />

  <PropertyGroup>
    <GameDataDir Condition="'$(GameDataDir)' == ''">$(GameDir)/data_sts2_windows_x86_64</GameDataDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
