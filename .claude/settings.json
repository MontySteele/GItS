{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/deny_dangerous_git.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python tools/hooks/push_gate.py",
            "timeout": 330
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python tools/hooks/game_ref_backup_reminder.py",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
