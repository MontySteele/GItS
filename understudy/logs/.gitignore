# Ephemeral harness scratch: the session cursor and the deck snapshot are
# state for the CURRENT run, not evidence about one. The decision log
# (phase0-<seed>.jsonl) is the instrument and IS committed.
_*

# Embark sidecars (`understudy/embark.py`): a pointer to a gitignored soak
# ledger plus absolute machine paths, written once per launch. Operator
# scratch for `--teardown`, not evidence -- the run seed it reads back is
# carried into the sealed record instead.
embark-*.json

# One-off wire probes (`*-probe.jsonl`): a raw dump of `GET
# /api/v1/singleplayer` either side of a posted action, taken to diagnose one
# defect and superseded by the fix and its red test. Same rule as the
# blind-play transcripts (R217 G) -- the raw read stays in a gitignored log
# and the excerpt that carried the finding goes in the commit message.
*-probe.jsonl

# Console captures from a backgrounded `blindplay session` / `embark`
# (`*-console.txt`): the same bytes the operator would have watched scroll
# past, kept only so a crashed run can be read back. Operator scratch, not
# evidence -- the transcript beside it is the record.
*-console.txt
