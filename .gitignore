.venv/
__pycache__/
*.pyc
.pytest_cache/
*.csv
.DS_Store

# Claude Code sibling worktrees live here; the checkouts are local scratch and
# never repo content. Their tips are archived to origin as archive/* branches.
.claude/worktrees/

# Tier F art (principles §9: never ships, never distributed — repo is public).
# Only the ledgers (SOURCES.tsv, plan.tsv) and tools are tracked.
art/raw/
art/candidates/
art/contact_sheet.html
art/contact_sheet_*.html
art/picks.tsv
ImageGen/images/
# Design mockups inline the real member sprites as base64 to preview against
# the live art (docs/mockups/salon-stage-d1-mockup-2026-07-28.html embeds three
# Tier F PNGs from ImageGen/images/furina/salon/). An embedded copy distributes
# exactly what the line above refuses to, so the mockups stay local and the
# briefs that cite them say so.
docs/mockups/

# In-game G2 captures (Track I, I2). Each shot is a card rendered at full size
# with its Tier F illustration in the frame, so committing them distributes the
# same material art/candidates/ is ignored for. The page cites them by path and
# the capture procedure in docs/archive/g12-review-2026-08-05.md §3 reproduces them.
# _TRACKB2_save_backup/ holds a byte copy of a leftover run save found in the
# game dir at the start of I2 — a save file, not art, but equally not repo
# content.
art/g12_captures/
# Live-game capture packets. Same rule and the same reason: every frame is the
# whole running game with Tier F art in it. Cited by path from
# review/active/livegame-captures-2026-08-08.md.
art/eb52_captures/

# Raw art asset zips are shared out-of-band and dropped in the repo root on
# purpose. They must never be committed (same §9 reasoning as above).
*.zip

# --- C-milestones: machine-local build files (spec csharp-build-spec.md §0.3) ---
# Never commit anything that points at this machine's Steam install.
local.props
bin/
obj/
dist/
*.user

# Extracted / decompiled base-game material is REFERENCE ONLY and stays out
# of the repo entirely (§0.3). Decompiled MegaCrit code is not ours to vendor.
sts2_decompiled/
game_assets/
# tools/extract_base_game_pool.py output -- regenerate locally, never commit
game_ref/
# tools/patch_sentinel.py self-blessed snapshots. Same rule and same reason as
# game_ref/: their CONTENT is base-game material (relic names, rarities, printed
# numbers), so they are a local artifact even though the tool that writes them
# is committed.
.sentinel/
*.pck
*.pck.contract.txt
*.dll
*.pdb

# card gallery (tools/render_card_gallery.py) -- a local eyeball view, regenerated on demand
card_gallery.html
