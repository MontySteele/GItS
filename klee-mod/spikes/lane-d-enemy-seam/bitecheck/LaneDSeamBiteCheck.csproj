<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lane D's offline evidence harness. Same idea as
       klee-mod/build/bitecheck: run the seam against the REAL game assembly
       outside Godot and report what happened. Deliberately not referenced by
       any deploy or build script. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>laned-seam-bitecheck</AssemblyName>
    <RootNamespace>LaneD.EnemySeam.BiteCheck</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EnemySeamSpike\EnemySeamSpike.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=TRUE, unlike the spike itself. This exe never enters the game
         directory, and it needs 0Harmony beside it because the JIT resolves
         HarmonyLib before Main's first statement can install an
         AssemblyResolve handler. sts2 / GodotSharp / BaseLib stay Private=false
         and are resolved at RUN time by that handler. -->
    <Reference Include="0Harmony">
      <HintPath>$(GameDataDir)\0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(GameDataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BaseLib">
      <HintPath>$(BaseLibDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="EmitLocalPaths" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <LocalPathsFile>$(IntermediateOutputPath)LocalPaths.g.cs</LocalPathsFile>
    </PropertyGroup>
    <WriteLinesToFile
        File="$(LocalPathsFile)"
        Overwrite="true"
        WriteOnlyWhenDifferent="true"
        Lines="namespace LaneD.EnemySeam.BiteCheck %3B;internal static class LocalPaths;{;    public const string GameDataDir = @&quot;$(GameDataDir)&quot;%3B;    public const string BaseLibDll = @&quot;$(BaseLibDll)&quot;%3B;}" />
    <ItemGroup>
      <Compile Include="$(LocalPathsFile)" />
    </ItemGroup>
  </Target>

</Project>
