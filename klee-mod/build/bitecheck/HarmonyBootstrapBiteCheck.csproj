<Project Sdk="Microsoft.NET.Sdk">

  <!-- F2's bite-check harness. Deliberately NOT referenced by deploy.ps1 or by
       KleeCode.csproj: it is a manual gate, run by hand when the Harmony
       bootstrap changes. It sits under klee-mod/ so Directory.Build.props
       resolves GameDataDir and BaseLibDll from local.props, which is why no
       Steam path appears in this file (spec 0.3). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>harmony-bitecheck</AssemblyName>
    <RootNamespace>KleeMod.BiteCheck</RootNamespace>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=TRUE here, unlike KleeCode.csproj. The mod must not ship a copy
         of 0Harmony (the game loads its own); this harness is a standalone exe
         that never enters the game directory, and it needs the assembly beside
         it because Main references HarmonyLib directly: the JIT resolves it
         before Main's first statement can install an AssemblyResolve handler. -->
    <Reference Include="0Harmony">
      <HintPath>$(GameDataDir)\0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- The game dir is a build-time fact here, so bake it in rather than making
       every invocation repeat it. sts2.dll and klee.dll are loaded reflectively
       at RUN time, not referenced, because loading them is the thing under
       test. -->
  <Target Name="EmitLocalPaths" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <LocalPathsFile>$(IntermediateOutputPath)LocalPaths.g.cs</LocalPathsFile>
    </PropertyGroup>
    <WriteLinesToFile
        File="$(LocalPathsFile)"
        Overwrite="true"
        WriteOnlyWhenDifferent="true"
        Lines="namespace KleeMod.BiteCheck %3B;internal static class LocalPaths;{;    public const string GameDataDir = @&quot;$(GameDataDir)&quot;%3B;    public const string BaseLibDll = @&quot;$(BaseLibDll)&quot;%3B;}" />
    <ItemGroup>
      <Compile Include="$(LocalPathsFile)" />
    </ItemGroup>
  </Target>

</Project>
