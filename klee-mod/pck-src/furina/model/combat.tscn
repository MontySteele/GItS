[sub_resource type="Shader" id="Shader_element"]
code = "shader_type canvas_item;

uniform vec4 element : source_color = vec4(0.560784, 1.0, 0.839216, 1.0);
varying vec4 tint;

void vertex() {
	tint = COLOR;
}

void fragment() {
	vec4 heat = texture(TEXTURE, UV);
	COLOR = vec4(mix(element.rgb, vec3(1.0), smoothstep(0.72, 1.0, heat.r)), heat.a) * tint;
}"

