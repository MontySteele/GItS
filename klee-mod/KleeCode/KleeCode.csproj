<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>klee</AssemblyName>
    <RootNamespace>KleeMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <!-- QUARANTINED PROTOTYPE SURFACE (R213 B, BACKLOG EB-147).

       `dotnet build -p:PrototypeCards=true` compiles Cards/Prototype/** and
       defines PROTOTYPE_CARDS, which is what makes KleeMod.PrototypeCards
       hand the generated rows to each character's OFF-POOL list. WITHOUT the
       property the directory is not compiled at all, so a release build
       contains no prototype class and there is no id for anything to grant.

       Compile Remove (rather than a gitignore) because the generated files
       must stay COMMITTED and diffable: the staleness gate
       tools/gen_prototype_cards.py (with the check flag) reads them, and a
       surface that vanished from the tree would take its own audit trail
       with it.

       build/deploy.ps1 and build/validate.ps1 deliberately never set this. -->
  <PropertyGroup Condition="'$(PrototypeCards)' == 'true'">
    <DefineConstants>$(DefineConstants);PROTOTYPE_CARDS</DefineConstants>
  </PropertyGroup>

  <!-- THE KLEE OVERHAUL ARM (the ruled brief klee-brief-2026-09-01.md sec.3,
       slice one klee-overhaul-slice-1-2026-09-01.md).

           dotnet build ... -p:PrototypeCards=true -p:KleeOverhaul=true

       A SECOND property rather than a third quarantine, because it gates an
       ARM and not a compilation unit. Everything the arm owns already lives
       under Powers/Prototype/** and Cards/Prototype/**, which the block below
       removes from a release build, so this property compiles nothing new
       and cannot reach a release build even if somebody passes it alone. All
       it moves is KleeOverhaul.Enabled's default, which the two wiring seams
       (Klee.StartingDeck and KleeCardPool.FilterThroughEpochs) read at
       runtime. The rules engine compiles either way on purpose: the headless
       pins must exercise the rules AND assert the flag-off wiring in ONE
       build, exactly as KleeTests.csproj already argues for PROTOTYPE_CARDS.

       The Sparks arm and the Kurage's memory are UNTOUCHED by this. A dev
       build compiles all three; with this property absent the overhaul arm is
       inert and the Sparks arm owns Klee's starter exactly as before. -->
  <PropertyGroup Condition="'$(KleeOverhaul)' == 'true'">
    <DefineConstants>$(DefineConstants);KLEE_OVERHAUL</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(PrototypeCards)' != 'true'">
    <Compile Remove="Cards/Prototype/**/*.cs" />
    <!-- The same quarantine, for a RULE rather than a card. Two arms use it and
         they are independent: the Kurage's memory
         (review/ruled/kokomi-kurage-memory-2026-08-29.md sec.11) and the Klee
         Sparks alternative cost (review/ruled/klee-sparks-2026-08-29.md
         sec.10). Both are engine (and, for Sparks, UI) behaviour rather than a
         sheet row, so neither has a generated class to sit in Cards/Prototype,
         and both are quarantined on exactly the same terms and by exactly the
         same switch. Every seam that calls into them from a SHIPPED file is
         itself inside #if PROTOTYPE_CARDS, so a release build neither compiles
         a rule nor references one, and the targeted revert is the flag. -->
    <Compile Remove="Powers/Prototype/**/*.cs" />
    <Compile Remove="Vfx/Prototype/**/*.cs" />
  </ItemGroup>

  <!-- Reference the game assembly + Harmony directly. Private=false: the game
       loads these from its own data folder, we must not ship copies. -->
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- BaseLib is a Workshop mod loaded before us (see manifest dependencies).
         Needed for CustomCardModel.CustomPortrait, which accepts a Texture2D
         object and so lets us ship loose PNGs instead of building a .pck. -->
    <Reference Include="BaseLib">
      <HintPath>$(BaseLibDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
