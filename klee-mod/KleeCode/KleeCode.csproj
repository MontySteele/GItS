<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>klee</AssemblyName>
    <RootNamespace>KleeMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <!-- QUARANTINED PROTOTYPE SURFACE (R213 B, BACKLOG EB-147).

       `dotnet build -p:PrototypeCards=true` compiles Cards/Prototype/** and
       defines PROTOTYPE_CARDS, which is what makes KleeMod.PrototypeCards
       hand the generated rows to each character's OFF-POOL list. WITHOUT the
       property the directory is not compiled at all, so a release build
       contains no prototype class and there is no id for anything to grant.

       Compile Remove (rather than a gitignore) because the generated files
       must stay COMMITTED and diffable: the staleness gate
       tools/gen_prototype_cards.py (with the check flag) reads them, and a
       surface that vanished from the tree would take its own audit trail
       with it.

       build/deploy.ps1 and build/validate.ps1 deliberately never set this. -->
  <PropertyGroup Condition="'$(PrototypeCards)' == 'true'">
    <DefineConstants>$(DefineConstants);PROTOTYPE_CARDS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(PrototypeCards)' != 'true'">
    <Compile Remove="Cards/Prototype/**/*.cs" />
    <!-- The same quarantine, for a RULE rather than a card. The Kurage's
         memory (review/active/kokomi-kurage-memory-2026-08-29.md sec.11) is
         engine behaviour, not a sheet row, so it has no generated class to sit
         in Cards/Prototype, but it is quarantined on exactly the same terms
         and by exactly the same switch. Every seam that calls into it from a
         SHIPPED file is itself inside #if PROTOTYPE_CARDS, so a release build
         neither compiles the rule nor references it, and the targeted revert
         is the flag. -->
    <Compile Remove="Powers/Prototype/**/*.cs" />
  </ItemGroup>

  <!-- Reference the game assembly + Harmony directly. Private=false: the game
       loads these from its own data folder, we must not ship copies. -->
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDataDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- BaseLib is a Workshop mod loaded before us (see manifest dependencies).
         Needed for CustomCardModel.CustomPortrait, which accepts a Texture2D
         object and so lets us ship loose PNGs instead of building a .pck. -->
    <Reference Include="BaseLib">
      <HintPath>$(BaseLibDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
