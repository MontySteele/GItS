<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EB-105. The mod's first C# test project. Runs HEADLESS (`dotnet test`,
    no Godot, no game launch) for the same reason the F2 bite-check does:
    sts2.dll is a plain net9.0 assembly, so its non-visual types can be
    constructed and its methods called with no scene tree.

    Deliberately NOT referenced by deploy.ps1. validate.ps1 gains an OPTIONAL
    -RunTests switch; making it mandatory for a deploy is a [USER] call
    (README.md, "Not a deploy gate yet").
  -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>KleeTests</AssemblyName>
    <RootNamespace>KleeMod.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The game assemblies are not on a NuGet feed and the reference set is resolved from local.props. -->
    <NoWarn>$(NoWarn);CS8002</NoWarn>
  </PropertyGroup>

  <!-- THE QUARANTINE, on the test side. `Prototype/` holds pins for rules that
       exist only under `-p:PrototypeCards=true` (KleeCode.csproj); without the
       property the rule's types are not compiled, so a pin against them would
       not compile either. Same switch, same condition, so `dotnet test` and
       `dotnet test -p:PrototypeCards=true` both build.

       PROTOTYPE_CARDS is defined here as well as removed-from, because one fact
       has to be asserted BOTH ways round: that the base Spark rule is retired
       under the flag and still runs without it. A pin that could only be
       compiled on one side of the switch could not say the second half. -->
  <PropertyGroup Condition="'$(PrototypeCards)' == 'true'">
    <DefineConstants>$(DefineConstants);PROTOTYPE_CARDS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(PrototypeCards)' != 'true'">
    <Compile Remove="Prototype/**/*.cs" />
  </ItemGroup>

  <!-- The Klee overhaul arm, mirrored here so `-p:KleeOverhaul=true` builds
       the test project too. The arm's pins do NOT need it: the rules engine
       compiles under PrototypeCards alone and `KleeOverhaul.Enabled` is
       settable, so one build asserts both sides of the switch. This exists so
       a dev running the game's own build line over the tests gets the same
       DefineConstants and cannot hit a "property means nothing here" surprise. -->
  <PropertyGroup Condition="'$(KleeOverhaul)' == 'true'">
    <DefineConstants>$(DefineConstants);KLEE_OVERHAUL</DefineConstants>
  </PropertyGroup>

  <!-- The Mondstadt companion overhaul arm, mirrored here on exactly the terms
       above and for the same reason. Its pins do not need the property either:
       `CompanionOverhaul.Enabled` is settable, so one build asserts both sides
       of the switch, including the flag-off acceptance condition: that
       CompanionPool.All is the generated roster, unchanged. -->
  <PropertyGroup Condition="'$(CompanionOverhaul)' == 'true'">
    <DefineConstants>$(DefineConstants);COMPANION_OVERHAUL</DefineConstants>
  </PropertyGroup>

  <!-- The Kokomi overhaul arm, mirrored here on exactly the terms above and
       for the same reason. Its pins do not need the property either:
       `KokomiOverhaul.Enabled` is settable, so one build asserts both sides of
       the switch, including the flag-off acceptance condition: that her
       starter, her starting relic and her offerable pool are the shipped ones,
       unchanged. -->
  <PropertyGroup Condition="'$(KokomiOverhaul)' == 'true'">
    <DefineConstants>$(DefineConstants);KOKOMI_OVERHAUL</DefineConstants>
  </PropertyGroup>

  <!-- The Furina stage arm, mirrored here on exactly the terms above and for
       the same reason. Its pins do not need the property: FurinaStage.Enabled
       is settable, so one build asserts both sides of the switch, including
       the flag-off acceptance condition: that her starter deck, her starting
       relic and her damage pipeline are the shipped ones, unchanged. -->
  <PropertyGroup Condition="'$(FurinaStage)' == 'true'">
    <DefineConstants>$(DefineConstants);FURINA_STAGE</DefineConstants>
  </PropertyGroup>

  <!-- The Teyvat run frame arm, mirrored here on exactly the terms above and
       for the same reason. Its pins do not need the property:
       `TeyvatFrame.Enabled` is settable, so one build asserts both sides of
       the switch, including the flag-off acceptance condition: that
       `ModelDb.Acts` is the base game's four acts, unchanged. -->
  <PropertyGroup Condition="'$(TeyvatFrame)' == 'true'">
    <DefineConstants>$(DefineConstants);TEYVAT_FRAME</DefineConstants>
  </PropertyGroup>

  <!-- THE BRIDGE'S PORT RESOLVER, compiled into this assembly rather than
       referenced. `vendor/STS2_MCP/gits/GitsPort.cs` is deliberately free of
       Godot, Harmony and game types precisely so the one decision that must
       be right for two instances to coexist can be exercised headlessly; the
       bridge project itself cannot be referenced here because it targets the
       game's own assemblies through a different property set. One file, no
       fork: this compiles the SAME source the mod ships. -->
  <ItemGroup>
    <Compile Include="../../vendor/STS2_MCP/gits/GitsPort.cs"
             Link="Vendor/GitsPort.cs" />
  </ItemGroup>

  <!-- EB-184's per-mode aiming reader, on the same terms and for the same
       reason. `GitsModalTargeting.cs` reads two members off a played card BY
       NAME and holds no game type of its own, so the decision that repairs the
       "Card requires a target" refusal on a targetless mode can be exercised
       headlessly against fake cards, including the half that must NOT move:
       an aiming mode still owing its target. One file, no fork. -->
  <ItemGroup>
    <Compile Include="../../vendor/STS2_MCP/gits/GitsModalTargeting.cs"
             Link="Vendor/GitsModalTargeting.cs" />
  </ItemGroup>

  <!-- EB-761's event-cursor arithmetic, on the same terms and for the same
       reason. `GitsForceEvent.cs` holds the one index `force_next_event`
       computes (`events[eventsVisited % events.Count]`, the slot the act
       reads NEXT and not index 0) and holds no game type, so a decision
       that would otherwise only be checkable with a live run up is exercised
       headlessly. The half that needs `ActModel` (the reflection read of the
       act's RoomSet, and the two refusals that depend on a run) stays in
       `gits/GitsDebugState.cs`. One file, no fork. -->
  <ItemGroup>
    <Compile Include="../../vendor/STS2_MCP/gits/GitsForceEvent.cs"
             Link="Vendor/GitsForceEvent.cs" />
  </ItemGroup>

  <!-- EB-771's act-skip decision, on the same terms and for the same reason.
       `GitsSkipAct.cs` decides whether a run may leave its act right now and
       which act it lands in, and holds no game type, so the four refusals
       (a live combat, a stacked sub-room, the victory room, and the LAST act,
       where the native call opens The Architect's room instead of advancing)
       are pinned headlessly rather than only being discoverable with a run up
       in the very act that would prove them. The half that needs `RunManager`
       (reading the live run and calling
       `ActChangeSynchronizer.SetLocalPlayerReady`) stays in
       `gits/GitsDebugState.cs`. One file, no fork. -->
  <ItemGroup>
    <Compile Include="../../vendor/STS2_MCP/gits/GitsSkipAct.cs"
             Link="Vendor/GitsSkipAct.cs" />
  </ItemGroup>

  <!-- EB-748's refusal reader, on the same terms and for the same reason.
       `GitsRefusalSource.cs` turns whatever `CardModel.CanPlay` hands back as
       the PREVENTER into the sentence a blind page prints, and it does that by
       reflection over an object whose static type the bridge deliberately does
       not name, so both of its failure directions are invisible to a compile
       and expensive to reach with a run up: a preventer whose name it cannot
       read prints nothing and looks exactly like the defect this was filed
       for, and a slot holding something that is not a preventer at all would
       print "True is stopping you right now". The file holds no game type, so
       both are decided headlessly here. One file, no fork. -->
  <ItemGroup>
    <Compile Include="../../vendor/STS2_MCP/gits/GitsRefusalSource.cs"
             Link="Vendor/GitsRefusalSource.cs" />
  </ItemGroup>

  <!-- EB-676's settled-HP predicate, on the same terms and for the same
       reason. `GitsSettledHp.cs` decides whether the HP figure on a state
       payload is the one the run has settled on or one read with work still
       in flight, and it holds no game type, so the clause that matters is
       pinned headlessly. It matters because the OBVIOUS version of this
       predicate, `!CombatManager.Instance.IsInProgress`, is ALREADY false
       on the very frame the defect was filed against (the game's own summary
       of that property: "False when ... the combat is ending"), so the wrong
       answer looks exactly like the right one until a fight happens to end on
       a damage-over-time power and a seat reads its map off a number 9 too
       high. Both states are pinned, the kill screen and the map after it. The
       half that needs `RunManager` and `CombatManager` (reading the four live
       facts) stays in `McpMod.StateBuilder.cs`, where it is one try/catch over
       the answer this file computes. One file, no fork. -->
  <ItemGroup>
    <Compile Include="../../vendor/STS2_MCP/gits/GitsSettledHp.cs"
             Link="Vendor/GitsSettledHp.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- The mod under test. ProjectReference so `dotnet test` rebuilds klee.dll
       and can never grade a stale binary. -->
  <ItemGroup>
    <ProjectReference Include="..\KleeCode\KleeCode.csproj" />
  </ItemGroup>

  <!-- Private=TRUE here, unlike KleeCode.csproj and for the same reason the
       bite-check flips it: this assembly never enters the game directory, and the test host resolves references from its own output folder. Copying sts2.dll into bin/ is how the harness loads real game types at all. GodotSharp is copied because sts2 references it; nothing here may CALL it (see README, the headless boundary). -->
  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDataDir)\sts2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataDir)\0Harmony.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)\GodotSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="BaseLib">
      <HintPath>$(BaseLibDll)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
